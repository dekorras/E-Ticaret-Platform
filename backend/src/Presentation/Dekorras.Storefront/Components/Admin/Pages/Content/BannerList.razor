@page "/admin/cms/banners"
@attribute [Authorize]
@rendermode InteractiveServer
@using Dekorras.Application.Content.Commands
@using Dekorras.Application.Content.Queries
@inject MediatR.ISender Sender

<PageTitle>Ana Sayfa Bannerları</PageTitle>

<div class="page-title-box d-sm-flex align-items-center justify-content-between">
    <h4 class="mb-sm-0">Ana Sayfa Bannerları</h4>
    <a class="btn btn-primary" href="/admin/cms/banners/new">+ Yeni Banner</a>
</div>
<p class="text-muted">Anasayfada gösterilen görsel banner'lar - gösterim sırası küçükten büyüğe sıralanır.</p>

@if (_banners is null)
{
    <p>Yükleniyor...</p>
}
else if (_banners.Count == 0)
{
    <p class="text-muted">Henüz bir banner yok.</p>
}
else
{
    <div class="d-flex flex-wrap gap-3 mb-4">
        @foreach (var banner in _banners)
        {
            <div class="card" style="width: 220px;">
                <img src="@banner.ImageUrl" class="card-img-top" style="height: 120px; object-fit: cover;" />
                <div class="card-body p-2">
                    <p class="small mb-1">Sıra: @banner.DisplayOrder</p>
                    @if (banner.LinkUrl is not null)
                    {
                        <p class="small text-muted text-truncate mb-1">@banner.LinkUrl</p>
                    }
                    <span class="badge @(banner.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") mb-1">@(banner.IsActive ? "Aktif" : "Pasif")</span>
                    <div class="d-flex gap-1 mt-1">
                        @if (banner.IsActive)
                        {
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => ToggleActiveAsync(banner.Id, false)">Pasife Al</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="() => ToggleActiveAsync(banner.Id, true)">Aktifleştir</button>
                        }
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAsync(banner.Id)">Sil</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyCollection<BannerDto>? _banners;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _banners = await Sender.Send(new GetBannersQuery());

    private async Task ToggleActiveAsync(Guid id, bool isActive)
    {
        await Sender.Send(new SetBannerActiveCommand(id, isActive));
        await LoadAsync();
    }

    private async Task RemoveAsync(Guid id)
    {
        await Sender.Send(new RemoveBannerCommand(id));
        await LoadAsync();
    }
}
