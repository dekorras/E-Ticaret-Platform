@page "/admin/cms/pages"
@attribute [Authorize]
@rendermode InteractiveServer
@using Dekorras.Application.Common
@using Dekorras.Application.Content.Commands
@using Dekorras.Application.Content.Queries
@inject MediatR.ISender Sender

<PageTitle>Bilgi Sayfaları</PageTitle>

<div class="page-title-box d-sm-flex align-items-center justify-content-between">
    <h4 class="mb-sm-0">Bilgi Sayfaları (CMS)</h4>
    <a class="btn btn-primary" href="/admin/cms/pages/new">+ Yeni Sayfa</a>
</div>
<p class="text-muted">
    Gizlilik Politikası, Mesafeli Satış Sözleşmesi, İptal/İade Koşulları gibi statik kurumsal/yasal
    sayfalar burada yönetilir - Storefront'ta <code>/sayfa/{slug}</code> altında görünür. İçerik HTML
    olarak saklanır. <strong>Not: yasal metinlerin gerçek, hukuken doğru içeriği bu ekrandan elle
    girilmelidir - burada hazır bir şablon YOKTUR.</strong>
</p>

<div class="mb-3" style="max-width: 300px;">
    <label class="form-label">Görüntülenen/Düzenlenen Dil</label>
    <select class="form-select" @bind="_editingLanguageCode" @bind:after="LoadAsync">
        @foreach (var language in SupportedLanguages.All)
        {
            <option value="@language.Code">@language.DisplayName</option>
        }
    </select>
</div>

@if (_pages is null)
{
    <p>Yükleniyor...</p>
}
else if (_pages.Count == 0)
{
    <p class="text-muted">Henüz bir sayfa yok.</p>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive table-card">
                <table id="cmsPagesTable" class="table table-nowrap align-middle mb-0">
                    <thead><tr><th>Başlık</th><th>Slug</th><th>Durum</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var cmsPage in _pages)
                        {
                            <tr>
                                <td>@cmsPage.Title</td>
                                <td><code>/sayfa/@cmsPage.Slug</code></td>
                                <td>
                                    <span class="badge @(cmsPage.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@(cmsPage.IsActive ? "Aktif" : "Pasif")</span>
                                </td>
                                <td>
                                    <a class="btn btn-sm btn-outline-secondary" href="/admin/cms/pages/@cmsPage.Id">Düzenle</a>
                                    @if (cmsPage.IsActive)
                                    {
                                        <button class="btn btn-sm btn-outline-warning ms-1" @onclick="() => ToggleActiveAsync(cmsPage.Id, false)">Pasife Al</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success ms-1" @onclick="() => ToggleActiveAsync(cmsPage.Id, true)">Aktifleştir</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <DataTableScript TableId="cmsPagesTable" ReloadToken="_pages" />
            </div>
        </div>
    </div>
}

@code {
    private string _editingLanguageCode = "tr";

    private IReadOnlyCollection<CmsPageListItemDto>? _pages;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _pages = await Sender.Send(new GetCmsPagesQuery(_editingLanguageCode));

    private async Task ToggleActiveAsync(Guid id, bool isActive)
    {
        await Sender.Send(new SetCmsPageActiveCommand(id, isActive));
        await LoadAsync();
    }
}
