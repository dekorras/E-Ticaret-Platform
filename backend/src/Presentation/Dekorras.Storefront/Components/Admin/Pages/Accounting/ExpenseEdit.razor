@page "/admin/accounting/expenses/new"
@attribute [Authorize(Policy = "AccountingAccess")]
@rendermode InteractiveServer
@using Dekorras.Application.Accounting.Commands
@inject MediatR.ISender Sender
@inject NavigationManager NavigationManager

<PageTitle>Yeni Gider</PageTitle>

<div class="page-title-box d-sm-flex align-items-center justify-content-between">
    <h4 class="mb-sm-0">Yeni Gider</h4>
</div>

<div class="card">
    <div class="card-body" style="max-width: 600px;">
        <div class="mb-2">
            <label class="form-label">Kategori</label>
            <input class="form-control" placeholder="ör. Kira, Elektrik" @bind="_categoryName" />
        </div>
        <div class="mb-2">
            <label class="form-label">Tutar</label>
            <input type="number" step="0.01" class="form-control" @bind="_amountText" />
        </div>
        <div class="mb-2">
            <label class="form-label">Tarih</label>
            <input type="date" class="form-control" @bind="_expenseDate" />
        </div>
        <div class="mb-2">
            <label class="form-label">Açıklama</label>
            <input class="form-control" placeholder="opsiyonel" @bind="_description" />
        </div>

        @if (_error is not null)
        {
            <p class="text-danger mt-2">@_error</p>
        }

        <button class="btn btn-success mt-2" @onclick="CreateAsync">Kaydet</button>
        <a class="btn btn-secondary ms-2 mt-2" href="/admin/accounting/expenses">Vazgeç</a>
    </div>
</div>

@code {
    private string _categoryName = "";
    private string _amountText = "";
    private DateTime _expenseDate = DateTime.Today;
    private string _description = "";
    private string? _error;

    private async Task CreateAsync()
    {
        _error = null;
        if (!decimal.TryParse(_amountText, out var amount))
        {
            _error = "Geçerli bir tutar girin.";
            return;
        }

        try
        {
            await Sender.Send(new CreateExpenseCommand(_categoryName, amount, _expenseDate.ToUniversalTime(), string.IsNullOrWhiteSpace(_description) ? null : _description));
            NavigationManager.NavigateTo("/admin/accounting/expenses");
        }
        catch (FluentValidation.ValidationException ex)
        {
            _error = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
    }
}
