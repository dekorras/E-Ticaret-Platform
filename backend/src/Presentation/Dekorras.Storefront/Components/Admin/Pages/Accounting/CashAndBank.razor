@page "/admin/accounting/cash-and-bank"
@attribute [Authorize(Policy = "AccountingAccess")]
@rendermode InteractiveServer
@using Dekorras.Application.Accounting.Commands
@using Dekorras.Application.Accounting.Queries
@using Dekorras.Domain.Common
@inject MediatR.ISender Sender

<PageTitle>Kasa &amp; Banka</PageTitle>

<a class="btn btn-secondary mb-3" href="/admin/accounting">← Muhasebe Modülü</a>
<div class="page-title-box d-sm-flex align-items-center justify-content-between">
    <h4 class="mb-sm-0">Kasa &amp; Banka</h4>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="d-flex align-items-center justify-content-between">
            <h4>Kasalar</h4>
            <a class="btn btn-primary btn-sm" href="/admin/accounting/cash-registers/new">+ Yeni Kasa</a>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="table-responsive table-card">
                    <table class="table table-nowrap align-middle mb-0">
                        <thead><tr><th>Ad</th><th>Bakiye</th><th></th></tr></thead>
                        <tbody>
                            @if (_cashRegisters is not null)
                            {
                                @foreach (var register in _cashRegisters)
                                {
                                    <tr>
                                        <td>@register.Name</td>
                                        <td>@register.BalanceTry.ToString("N2") ₺</td>
                                        <td>
                                            <div class="input-group input-group-sm" style="max-width: 260px;">
                                                <input type="number" step="0.01" class="form-control" @bind="_cashAmountText[register.Id]" placeholder="Tutar" />
                                                <button class="btn btn-outline-success" @onclick="() => DepositCashAsync(register.Id)">Yatır</button>
                                                <button class="btn btn-outline-danger" @onclick="() => WithdrawCashAsync(register.Id)">Çek</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        @if (_cashError is not null)
        {
            <p class="text-danger mt-2">@_cashError</p>
        }
    </div>

    <div class="col-md-6">
        <div class="d-flex align-items-center justify-content-between">
            <h4>Banka Hesapları</h4>
            <a class="btn btn-primary btn-sm" href="/admin/accounting/bank-accounts/new">+ Yeni Banka Hesabı</a>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="table-responsive table-card">
                    <table class="table table-nowrap align-middle mb-0">
                        <thead><tr><th>Banka</th><th>IBAN</th><th>Bakiye</th><th></th></tr></thead>
                        <tbody>
                            @if (_bankAccounts is not null)
                            {
                                @foreach (var account in _bankAccounts)
                                {
                                    <tr>
                                        <td>@account.BankName</td>
                                        <td class="small">@account.Iban</td>
                                        <td>@account.BalanceTry.ToString("N2") ₺</td>
                                        <td>
                                            <div class="input-group input-group-sm" style="max-width: 260px;">
                                                <input type="number" step="0.01" class="form-control" @bind="_bankAmountText[account.Id]" placeholder="Tutar" />
                                                <button class="btn btn-outline-success" @onclick="() => DepositBankAsync(account.Id)">Yatır</button>
                                                <button class="btn btn-outline-danger" @onclick="() => WithdrawBankAsync(account.Id)">Çek</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        @if (_bankError is not null)
        {
            <p class="text-danger mt-2">@_bankError</p>
        }
    </div>
</div>

@code {
    private IReadOnlyCollection<CashRegisterDto>? _cashRegisters;
    private IReadOnlyCollection<BankAccountDto>? _bankAccounts;
    private readonly Dictionary<Guid, string> _cashAmountText = [];
    private readonly Dictionary<Guid, string> _bankAmountText = [];

    private string? _cashError;
    private string? _bankError;

    protected override async Task OnInitializedAsync()
    {
        await LoadCashRegistersAsync();
        await LoadBankAccountsAsync();
    }

    private async Task LoadCashRegistersAsync()
    {
        _cashRegisters = await Sender.Send(new GetCashRegistersQuery());
        foreach (var register in _cashRegisters)
            _cashAmountText.TryAdd(register.Id, "");
    }

    private async Task LoadBankAccountsAsync()
    {
        _bankAccounts = await Sender.Send(new GetBankAccountsQuery());
        foreach (var account in _bankAccounts)
            _bankAmountText.TryAdd(account.Id, "");
    }

    private async Task DepositCashAsync(Guid cashRegisterId)
    {
        _cashError = null;
        if (!decimal.TryParse(_cashAmountText.GetValueOrDefault(cashRegisterId), out var amount)) { _cashError = "Geçerli bir tutar girin."; return; }

        await Sender.Send(new DepositToCashRegisterCommand(cashRegisterId, amount));
        _cashAmountText[cashRegisterId] = "";
        await LoadCashRegistersAsync();
    }

    private async Task WithdrawCashAsync(Guid cashRegisterId)
    {
        _cashError = null;
        if (!decimal.TryParse(_cashAmountText.GetValueOrDefault(cashRegisterId), out var amount)) { _cashError = "Geçerli bir tutar girin."; return; }

        try
        {
            await Sender.Send(new WithdrawFromCashRegisterCommand(cashRegisterId, amount));
            _cashAmountText[cashRegisterId] = "";
            await LoadCashRegistersAsync();
        }
        catch (DomainException ex)
        {
            _cashError = ex.Message;
        }
    }

    private async Task DepositBankAsync(Guid bankAccountId)
    {
        _bankError = null;
        if (!decimal.TryParse(_bankAmountText.GetValueOrDefault(bankAccountId), out var amount)) { _bankError = "Geçerli bir tutar girin."; return; }

        await Sender.Send(new DepositToBankAccountCommand(bankAccountId, amount));
        _bankAmountText[bankAccountId] = "";
        await LoadBankAccountsAsync();
    }

    private async Task WithdrawBankAsync(Guid bankAccountId)
    {
        _bankError = null;
        if (!decimal.TryParse(_bankAmountText.GetValueOrDefault(bankAccountId), out var amount)) { _bankError = "Geçerli bir tutar girin."; return; }

        try
        {
            await Sender.Send(new WithdrawFromBankAccountCommand(bankAccountId, amount));
            _bankAmountText[bankAccountId] = "";
            await LoadBankAccountsAsync();
        }
        catch (DomainException ex)
        {
            _bankError = ex.Message;
        }
    }
}
