@page "/admin/accounting/checks/new"
@attribute [Authorize(Policy = "AccountingAccess")]
@rendermode InteractiveServer
@using Dekorras.Application.Accounting.Commands
@using Dekorras.Application.Accounting.Queries
@inject MediatR.ISender Sender
@inject NavigationManager NavigationManager

<PageTitle>Yeni Çek</PageTitle>

<div class="page-title-box d-sm-flex align-items-center justify-content-between">
    <h4 class="mb-sm-0">Yeni Çek</h4>
</div>

<div class="card">
    <div class="card-body" style="max-width: 600px;">
        <div class="mb-2">
            <label class="form-label">Cari Hesap</label>
            <select class="form-select" @bind="_newCheckLedgerAccountId">
                <option value="">Cari Hesap Seçin</option>
                @if (_ledgerAccounts is not null)
                {
                    @foreach (var account in _ledgerAccounts)
                    {
                        <option value="@account.Id">@account.Name</option>
                    }
                }
            </select>
        </div>
        <div class="mb-2">
            <label class="form-label">Çek No</label>
            <input class="form-control" @bind="_newCheckNumber" />
        </div>
        <div class="mb-2">
            <label class="form-label">Tutar</label>
            <input type="number" step="0.01" class="form-control" @bind="_newCheckAmountText" />
        </div>
        <div class="mb-2">
            <label class="form-label">Vade</label>
            <input type="date" class="form-control" @bind="_newCheckDueDate" />
        </div>

        @if (_checkError is not null)
        {
            <p class="text-danger mt-1">@_checkError</p>
        }

        <button class="btn btn-success mt-2" @onclick="CreateCheckAsync">Kaydet</button>
        <a class="btn btn-secondary ms-2 mt-2" href="/admin/accounting/checks-and-notes">Vazgeç</a>
    </div>
</div>

@code {
    private IReadOnlyCollection<LedgerAccountListItemDto>? _ledgerAccounts;

    private string _newCheckLedgerAccountId = "";
    private string _newCheckNumber = "";
    private string _newCheckAmountText = "";
    private DateTime _newCheckDueDate = DateTime.Today;
    private string? _checkError;

    protected override async Task OnInitializedAsync()
    {
        _ledgerAccounts = await Sender.Send(new GetLedgerAccountsQuery());
    }

    private async Task CreateCheckAsync()
    {
        _checkError = null;
        if (!Guid.TryParse(_newCheckLedgerAccountId, out var accountId)) { _checkError = "Cari hesap seçin."; return; }
        if (!decimal.TryParse(_newCheckAmountText, out var amount)) { _checkError = "Geçerli bir tutar girin."; return; }

        try
        {
            await Sender.Send(new CreateCheckCommand(accountId, _newCheckNumber, amount, _newCheckDueDate.ToUniversalTime()));
            NavigationManager.NavigateTo("/admin/accounting/checks-and-notes");
        }
        catch (FluentValidation.ValidationException ex)
        {
            _checkError = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
    }
}
