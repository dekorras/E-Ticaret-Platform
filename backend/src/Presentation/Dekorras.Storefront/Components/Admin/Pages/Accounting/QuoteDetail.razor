@page "/admin/accounting/quotes/{Id:guid}"
@attribute [Authorize(Policy = "AccountingAccess")]
@rendermode InteractiveServer
@using Dekorras.Application.Accounting.Commands
@using Dekorras.Application.Accounting.Queries
@using Dekorras.Application.Integrations.Queries
@using Dekorras.Domain.Integrations
@inject MediatR.ISender Sender

<PageTitle>Teklif: @_quote?.QuoteNumber</PageTitle>

@if (_quote is null)
{
    <p>Yükleniyor...</p>
}
else
{
    <a class="btn btn-secondary mb-3" href="/admin/accounting/quotes">← Teklif Listesi</a>
    <div class="page-title-box d-sm-flex align-items-center justify-content-between">
        <h4 class="mb-sm-0">@_quote.QuoteNumber</h4>
    </div>
    <p>
        <a href="/admin/accounting/ledger-accounts/@_quote.LedgerAccountId">@_quote.LedgerAccountName</a>
        · Geçerlilik: @_quote.ValidUntilUtc.ToString("dd.MM.yyyy")
        @if (_quote.IsConverted)
        {
            <span class="badge bg-success-subtle text-success ms-1">Siparişe Dönüştü</span>
        }
        else if (_quote.ValidUntilUtc < DateTime.UtcNow)
        {
            <span class="badge bg-secondary-subtle text-secondary ms-1">Süresi Doldu</span>
        }
        else
        {
            <span class="badge bg-info-subtle text-info ms-1">Geçerli</span>
        }
    </p>

    <div class="card" style="max-width: 700px;">
        <div class="card-body">
            <div class="table-responsive table-card">
                <table class="table table-nowrap align-middle mb-0">
                    <thead><tr><th>Açıklama</th><th>Adet</th><th>Birim Fiyat</th><th>Tutar</th></tr></thead>
                    <tbody>
                        @foreach (var line in _quote.Lines)
                        {
                            <tr>
                                <td>@line.Description</td>
                                <td>@line.Quantity</td>
                                <td>@line.UnitPriceTry.ToString("N2") ₺</td>
                                <td>@line.LineTotalTry.ToString("N2") ₺</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold"><td colspan="3">Genel Toplam</td><td>@_quote.TotalAmountTry.ToString("N2") ₺</td></tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <hr class="mt-3" />
    <h4>Kalem Ekle</h4>
    <div class="row g-2" style="max-width: 800px;">
        <div class="col-4">
            <input class="form-control form-control-sm" placeholder="Açıklama" @bind="_lineDescription" />
        </div>
        <div class="col">
            <input type="number" step="0.01" class="form-control form-control-sm" placeholder="Birim Fiyat" @bind="_linePriceText" />
        </div>
        <div class="col">
            <input type="number" class="form-control form-control-sm" placeholder="Adet" @bind="_lineQuantity" />
        </div>
        <div class="col-auto">
            <button class="btn btn-sm btn-success" @onclick="AddLineAsync">Ekle</button>
        </div>
    </div>
    @if (_lineError is not null)
    {
        <p class="text-danger mt-1">@_lineError</p>
    }

    @if (!_quote.IsConverted && _quote.ValidUntilUtc >= DateTime.UtcNow)
    {
        <hr class="mt-4" />
        <h4>Siparişe Dönüştür</h4>
        <p class="text-muted">
            Teklif kabul edildiyse, checkout'takiyle AYNI akışla (gerçek bir ödeme/kargo sağlayıcısı
            üzerinden) bir sipariş oluşturulur.
        </p>
        <div class="row g-2" style="max-width: 700px;">
            <div class="col-6">
                <label class="form-label small">Ad Soyad / Firma Yetkilisi</label>
                <input class="form-control form-control-sm" @bind="_convertFullName" />
            </div>
            <div class="col-6">
                <label class="form-label small">E-posta</label>
                <input class="form-control form-control-sm" @bind="_convertEmail" />
            </div>
            <div class="col-6">
                <label class="form-label small">Telefon</label>
                <input class="form-control form-control-sm" @bind="_convertPhone" />
            </div>
            <div class="col-2">
                <label class="form-label small">Ülke Kodu</label>
                <input class="form-control form-control-sm" maxlength="2" @bind="_convertCountryCode" />
            </div>
            <div class="col-4">
                <label class="form-label small">Şehir</label>
                <input class="form-control form-control-sm" @bind="_convertCity" />
            </div>
            <div class="col-12">
                <label class="form-label small">Adres</label>
                <input class="form-control form-control-sm" @bind="_convertAddressLine1" />
            </div>
            <div class="col-6">
                <label class="form-label small">Ödeme Sağlayıcısı</label>
                <select class="form-select form-select-sm" @bind="_convertPaymentProviderKey">
                    <option value="">— Seçin —</option>
                    @if (_paymentProviders is not null)
                    {
                        @foreach (var provider in _paymentProviders)
                        {
                            <option value="@provider.ProviderKey">@provider.DisplayName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small">Kargo Sağlayıcısı</label>
                <select class="form-select form-select-sm" @bind="_convertCargoProviderKey">
                    <option value="">— Seçin —</option>
                    @if (_cargoProviders is not null)
                    {
                        @foreach (var provider in _cargoProviders)
                        {
                            <option value="@provider.ProviderKey">@provider.DisplayName</option>
                        }
                    }
                </select>
            </div>
        </div>
        <button class="btn btn-success mt-2" @onclick="ConvertToOrderAsync">Siparişe Dönüştür</button>

        @if (_convertError is not null)
        {
            <p class="text-danger mt-2">@_convertError</p>
        }
        @if (_convertedOrderId is Guid orderId)
        {
            <p class="text-success mt-2">
                Sipariş oluşturuldu: <a href="/admin/ecommerce/orders/@orderId">@_convertedOrderNumber</a>
                @if (!_convertedPaymentAuthorized)
                {
                    <span class="text-danger"> (ödeme yetkilendirmesi BAŞARISIZ - @_convertedPaymentMessage)</span>
                }
            </p>
        }
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private QuoteDetailDto? _quote;

    private string _lineDescription = "";
    private string _linePriceText = "";
    private int _lineQuantity = 1;
    private string? _lineError;

    private IReadOnlyCollection<ActiveProviderDto>? _paymentProviders;
    private IReadOnlyCollection<ActiveProviderDto>? _cargoProviders;
    private string _convertFullName = "";
    private string _convertEmail = "";
    private string _convertPhone = "";
    private string _convertCountryCode = "TR";
    private string _convertCity = "";
    private string _convertAddressLine1 = "";
    private string _convertPaymentProviderKey = "";
    private string _convertCargoProviderKey = "";
    private string? _convertError;
    private Guid? _convertedOrderId;
    private string? _convertedOrderNumber;
    private bool _convertedPaymentAuthorized;
    private string? _convertedPaymentMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _paymentProviders = await Sender.Send(new GetActiveProvidersQuery(ProviderCategory.Payment));
        _cargoProviders = await Sender.Send(new GetActiveProvidersQuery(ProviderCategory.Cargo));
    }

    private async Task LoadAsync() => _quote = await Sender.Send(new GetQuoteDetailQuery(Id));

    private async Task AddLineAsync()
    {
        _lineError = null;
        if (!decimal.TryParse(_linePriceText, out var price))
        {
            _lineError = "Geçerli bir birim fiyat girin.";
            return;
        }

        try
        {
            await Sender.Send(new AddQuoteLineCommand(Id, _lineDescription, price, _lineQuantity));
            _lineDescription = "";
            _linePriceText = "";
            _lineQuantity = 1;
            await LoadAsync();
        }
        catch (FluentValidation.ValidationException ex)
        {
            _lineError = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
    }

    private async Task ConvertToOrderAsync()
    {
        _convertError = null;
        try
        {
            var result = await Sender.Send(new ConvertQuoteToOrderCommand(
                Id, _convertFullName, _convertEmail, _convertPhone, _convertCountryCode,
                _convertCity, _convertAddressLine1, _convertPaymentProviderKey, _convertCargoProviderKey));

            _convertedOrderId = result.OrderId;
            _convertedOrderNumber = result.OrderNumber;
            _convertedPaymentAuthorized = result.PaymentAuthorized;
            _convertedPaymentMessage = result.PaymentMessage;
            await LoadAsync();
        }
        catch (FluentValidation.ValidationException ex)
        {
            _convertError = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException)
        {
            _convertError = ex.Message;
        }
    }
}
