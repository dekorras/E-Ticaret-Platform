@page "/admin/ecommerce/customers"
@attribute [Authorize(Policy = "ECommerceAccess")]
@rendermode InteractiveServer
@using Dekorras.Application.Customers.Queries
@inject MediatR.ISender Sender

<PageTitle>Müşteriler</PageTitle>

<div class="page-title-box d-sm-flex align-items-center justify-content-between">
    <h4 class="mb-sm-0">Müşteriler</h4>
</div>

<div class="mb-3" style="max-width: 400px;">
    <input class="form-control" placeholder="Ad veya e-posta ile ara..." @bind="_searchText" @bind:event="oninput" @bind:after="LoadAsync" />
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive table-card">
            <table id="customersTable" class="table table-nowrap align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ad Soyad</th>
                        <th>E-posta</th>
                        <th>Telefon</th>
                        <th>Grup</th>
                        <th>Tür</th>
                        <th>Sipariş</th>
                        <th>Kayıt Tarihi</th>
                        <th>Durum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_customers is not null)
                    {
                        @foreach (var customer in _customers)
                        {
                            <tr>
                                <td><a href="/admin/ecommerce/customers/@customer.Id">@customer.FullName</a></td>
                                <td>@customer.Email</td>
                                <td>@customer.PhoneNumber</td>
                                <td>@customer.GroupName</td>
                                <td>
                                    @if (customer.IsGuest)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Misafir</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info">Üye</span>
                                    }
                                </td>
                                <td>@customer.OrderCount</td>
                                <td data-order="@customer.CreatedAtUtc.ToString("o")">@customer.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td>
                                    <span class="badge @(customer.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@(customer.IsActive ? "Aktif" : "Pasif")</span>
                                </td>
                                <td><a class="btn btn-sm btn-outline-primary" href="/admin/ecommerce/customers/@customer.Id">Detay</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <DataTableScript TableId="customersTable" ReloadToken="_customers" />
        </div>
    </div>
</div>

@code {
    private string _searchText = "";
    private IReadOnlyCollection<CustomerListItemDto>? _customers;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() =>
        _customers = await Sender.Send(new GetCustomersQuery(string.IsNullOrWhiteSpace(_searchText) ? null : _searchText));
}
