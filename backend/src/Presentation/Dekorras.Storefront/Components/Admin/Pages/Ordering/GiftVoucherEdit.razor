@page "/admin/ecommerce/gift-vouchers/new"
@attribute [Authorize(Policy = "ECommerceAccess")]
@rendermode InteractiveServer
@using Dekorras.Application.Ordering.Commands
@inject MediatR.ISender Sender
@inject NavigationManager NavigationManager

<PageTitle>Yeni Hediye Çeki</PageTitle>

<div class="page-title-box d-sm-flex align-items-center justify-content-between">
    <h4 class="mb-sm-0">Yeni Hediye Çeki</h4>
</div>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <div class="mb-2">
            <label class="form-label">Kod</label>
            <input class="form-control" @bind="_code" placeholder="ör. HEDIYE100" />
        </div>
        <div class="mb-2">
            <label class="form-label">Tutar (TRY)</label>
            <input type="number" step="0.01" class="form-control" @bind="_amountTry" />
        </div>

        @if (_errorMessage is not null)
        {
            <p class="text-danger">@_errorMessage</p>
        }

        <button class="btn btn-success" @onclick="CreateAsync">Oluştur</button>
        <a class="btn btn-secondary ms-2" href="/admin/ecommerce/gift-vouchers">Vazgeç</a>
    </div>
</div>

@code {
    private string _code = "";
    private decimal _amountTry = 100;
    private string? _errorMessage;

    private async Task CreateAsync()
    {
        try
        {
            await Sender.Send(new CreateGiftVoucherCommand(_code, _amountTry));
            NavigationManager.NavigateTo("/admin/ecommerce/gift-vouchers");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
