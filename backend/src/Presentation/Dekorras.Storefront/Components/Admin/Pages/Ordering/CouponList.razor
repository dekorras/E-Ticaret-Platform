@page "/admin/ecommerce/coupons"
@attribute [Authorize(Policy = "ECommerceAccess")]
@rendermode InteractiveServer
@using Dekorras.Application.Ordering.Commands
@using Dekorras.Application.Ordering.Queries
@using Dekorras.Domain.Ordering
@inject MediatR.ISender Sender

<PageTitle>Kuponlar</PageTitle>

<div class="page-title-box d-sm-flex align-items-center justify-content-between">
    <h4 class="mb-sm-0">Kuponlar</h4>
    <a class="btn btn-primary" href="/admin/ecommerce/coupons/new">+ Yeni Kupon</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive table-card">
            <table id="couponsTable" class="table table-nowrap align-middle mb-0">
                <thead>
                    <tr>
                        <th>Kod</th>
                        <th>İndirim</th>
                        <th>Geçerlilik</th>
                        <th>Kullanım</th>
                        <th>Durum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_coupons is not null)
                    {
                        @foreach (var coupon in _coupons)
                        {
                            <tr>
                                <td><code>@coupon.Code</code></td>
                                <td data-order="@coupon.DiscountValue.ToString(System.Globalization.CultureInfo.InvariantCulture)">@(coupon.DiscountType == DiscountType.Percentage ? $"%{coupon.DiscountValue:0}" : $"{coupon.DiscountValue:N2} ₺")</td>
                                <td data-order="@coupon.ValidFromUtc.ToString("o")">@coupon.ValidFromUtc.ToLocalTime().ToString("dd.MM.yyyy") - @coupon.ValidToUtc.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td>@coupon.UsageCount@(coupon.UsageLimit is not null ? $" / {coupon.UsageLimit}" : "")</td>
                                <td>
                                    <span class="badge @(coupon.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@(coupon.IsActive ? "Aktif" : "Pasif")</span>
                                </td>
                                <td>
                                    @if (coupon.IsActive)
                                    {
                                        <button class="btn btn-sm btn-outline-warning" @onclick="() => ToggleActiveAsync(coupon.Id, false)">Pasife Al</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => ToggleActiveAsync(coupon.Id, true)">Aktifleştir</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <DataTableScript TableId="couponsTable" ReloadToken="_coupons" />
        </div>
    </div>
</div>

@code {
    private IReadOnlyCollection<CouponDto>? _coupons;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _coupons = await Sender.Send(new GetCouponsQuery());

    private async Task ToggleActiveAsync(Guid id, bool isActive)
    {
        await Sender.Send(new SetCouponActiveCommand(id, isActive));
        await LoadAsync();
    }
}
