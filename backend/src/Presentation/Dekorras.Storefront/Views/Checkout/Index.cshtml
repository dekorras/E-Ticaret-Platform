@using Dekorras.Application.Integrations.Queries
@using Dekorras.Application.Ordering.Storefront
@using Dekorras.Storefront.Models
@model CheckoutFormModel
@{
    ViewData["Title"] = "Ödeme";
    var cart = (CartDto)ViewBag.Cart;
    var paymentProviders = (IReadOnlyCollection<ActiveProviderDto>)ViewBag.PaymentProviders;
    var cargoProviders = (IReadOnlyCollection<ActiveProviderDto>)ViewBag.CargoProviders;
}

<h1 class="h3 mb-3">Ödeme</h1>

<div class="row">
    <div class="col-md-7">
        <form asp-controller="Checkout" asp-action="PlaceOrder" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-2">
                <label class="form-label">Ad Soyad</label>
                <input asp-for="FullName" class="form-control" />
            </div>
            <div class="mb-2">
                <label class="form-label">E-posta</label>
                <input asp-for="Email" class="form-control" />
            </div>
            <div class="mb-2">
                <label class="form-label">Telefon</label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>
            <div class="mb-2">
                <label class="form-label">Ülke Kodu</label>
                <input asp-for="CountryCode" class="form-control" style="max-width: 100px;" />
            </div>
            <div class="mb-2">
                <label class="form-label">Şehir</label>
                <input asp-for="City" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Adres</label>
                <textarea asp-for="AddressLine1" class="form-control"></textarea>
            </div>

            <h5>Kargo Yöntemi</h5>
            @if (cargoProviders.Count == 0)
            {
                <p class="text-danger">
                    Şu anda aktif bir kargo sağlayıcısı bulunmuyor. Yönetici, admin panelindeki
                    Entegrasyonlar ekranından en az bir kargo sağlayıcısını aktifleştirmelidir (bkz. plan §4.1).
                </p>
            }
            else
            {
                @foreach (var provider in cargoProviders)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="CargoProviderKey" id="cp-@provider.ProviderKey" value="@provider.ProviderKey" checked="@provider.IsDefault" />
                        <label class="form-check-label" for="cp-@provider.ProviderKey">@provider.DisplayName</label>
                    </div>
                }
            }

            <h5 class="mt-3">Ödeme Yöntemi</h5>
            @if (paymentProviders.Count == 0)
            {
                <p class="text-danger">
                    Şu anda aktif bir ödeme sağlayıcısı bulunmuyor. Yönetici, admin panelindeki
                    Entegrasyonlar ekranından en az bir ödeme sağlayıcısını aktifleştirmelidir (bkz. plan §4.1).
                </p>
            }
            else
            {
                @foreach (var provider in paymentProviders)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="PaymentProviderKey" id="pp-@provider.ProviderKey" value="@provider.ProviderKey" checked="@provider.IsDefault" />
                        <label class="form-check-label" for="pp-@provider.ProviderKey">@provider.DisplayName</label>
                    </div>
                }
            }

            <button type="submit" class="btn btn-success mt-3" disabled="@(paymentProviders.Count == 0 || cargoProviders.Count == 0)">Siparişi Tamamla</button>
        </form>
    </div>
    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Sipariş Özeti</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var item in cart.Items)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@item.Name@(item.VariantOptionName is not null ? $" ({item.VariantOptionName})" : "") × @item.Quantity</span>
                            <span>@Html.Money(item.LineTotalTry)</span>
                        </li>
                    }
                </ul>
                <p class="mt-2">Ara Toplam: @Html.Money(cart.SubTotalTry)</p>
                @if (cart.CouponCode is not null)
                {
                    <p class="text-success">Kupon (<code>@cart.CouponCode</code>): -@Html.Money(cart.DiscountTry)</p>
                }
                else if (cart.CampaignName is not null)
                {
                    <p class="text-success">Kampanya (<span class="fst-italic">@cart.CampaignName</span>): -@Html.Money(cart.DiscountTry)</p>
                }
                @if (cart.GiftVoucherCode is not null)
                {
                    <p class="text-success">Hediye Çeki (<code>@cart.GiftVoucherCode</code>): -@Html.Money(cart.GiftVoucherAmountAppliedTry)</p>
                }
                <p class="fw-bold">Toplam (kargo hariç): @Html.Money(cart.GrandTotalTry)</p>
                <p class="small text-muted">Kargo ücreti, seçtiğiniz kargo yöntemine göre sipariş tamamlandığında hesaplanır.</p>
                @if (ViewData["CurrencyCode"] as string != "TRY")
                {
                    <p class="small text-muted fst-italic">Gösterilen tutarlar yaklaşık dönüşümdür - ödemeniz Türk Lirası (₺) olarak tahsil edilir.</p>
                }
            </div>
        </div>
    </div>
</div>
