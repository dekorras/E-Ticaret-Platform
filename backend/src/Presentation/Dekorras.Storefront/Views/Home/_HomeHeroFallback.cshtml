@using Dekorras.Application.Content.Queries
@model IReadOnlyCollection<BannerDto>

@* BannerZone ("home-main") boş/tanımsız olduğunda gösterilen klasik hero carousel - eski davranış
   birebir korunuyor, BannerZone builder kullanılmayan mağazalar için geri dönüş (fallback). *@
@if (Model.Count > 0)
{
    <div id="homeBannerCarousel" class="carousel slide dk-hero mb-4" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (var i = 0; i < Model.Count; i++)
            {
                var banner = Model.ElementAt(i);
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    @if (banner.LinkUrl is not null)
                    {
                        <a href="@banner.LinkUrl">
                            <img src="@banner.ImageUrl" class="d-block w-100" alt="" />
                        </a>
                    }
                    else
                    {
                        <img src="@banner.ImageUrl" class="d-block w-100" alt="" />
                    }
                </div>
            }
        </div>
        @if (Model.Count > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
            </button>
        }
    </div>
}
else
{
    <div class="mb-4">
        <h1 class="display-5">Dekorras</h1>
        <p class="lead">@Localizer["Söve, duvar kaplaması, duvar kağıdı, taş desen panel, kartonpiyer ve poster."]</p>
    </div>
}
