@model Dekorras.Storefront.ViewComponents.AccountSidebarViewComponent.Model
@{
    // Bootstrap list-group; etkin başlık tema rengiyle (text-primary) ve kalın gösterilir.
    string Cls(string key, string extra = "") =>
        $"list-group-item list-group-item-action border-0 d-flex align-items-center gap-3 py-2 px-2 rounded dk-acc-link {extra} " +
        (Model.Active == key ? "is-active text-primary fw-semibold" : "fw-semibold");
}
<aside class="dk-acc-side" aria-label="Hesabım menüsü">
    <div class="d-flex align-items-center gap-3 mb-3">
        <span class="rounded-circle bg-body-secondary text-body-emphasis fw-semibold d-inline-flex align-items-center justify-content-center flex-shrink-0"
              style="width:56px;height:56px" aria-hidden="true">@Model.Initials</span>
        <span class="dk-acc-name fw-bold text-break">@Model.FullName</span>
    </div>

    <a class="dk-acc-promo d-flex align-items-center gap-3 p-3 mb-3 rounded-3 bg-danger-subtle text-body text-decoration-none" href="/duvar-kagitlari">
        <span class="flex-grow-1 lh-sm">
            <span class="d-block fw-bolder small text-danger" style="letter-spacing:.1em">DUVARIMDA DENE</span>
            <span class="d-block small">Ürünleri kendi odanızda görün</span>
        </span>
        <i class="bi bi-chevron-right text-danger" aria-hidden="true"></i>
    </a>

    <nav class="dk-acc-nav list-group list-group-flush">
        <a class="@Cls("orders")" asp-controller="Account" asp-action="Orders"><i class="bi bi-box-seam fs-5"></i> Siparişlerim</a>
        <a class="@Cls("offers")" asp-controller="Account" asp-action="Offers"><i class="bi bi-gem fs-5"></i> Sana Özel Fırsatlar</a>
        <a class="@Cls("requests")" asp-controller="Account" asp-action="Requests"><i class="bi bi-chat-square-text fs-5"></i> Soru ve Taleplerim</a>
        <a class="@Cls("reviews")" asp-controller="Account" asp-action="Reviews"><i class="bi bi-star fs-5"></i> Değerlendirmelerim</a>
        <a class="@Cls("coupons")" asp-controller="Account" asp-action="Coupons"><i class="bi bi-ticket-perforated fs-5"></i> Kuponlarım</a>
        <a class="@Cls("profile")" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-gear fs-5"></i> Kullanıcı bilgilerim</a>

        <div class="small fw-bold text-body-secondary text-uppercase px-2 mt-3 mb-1" style="letter-spacing:.08em">LİSTELERİM</div>
        <a class="@Cls("wishlist", "ps-4")" asp-controller="Account" asp-action="Wishlist"><i class="bi bi-heart fs-6"></i> Beğendiklerim</a>
        <a class="@Cls("lists", "ps-4")" asp-controller="Account" asp-action="Lists"><i class="bi bi-list-ul fs-6"></i> Tüm listelerim</a>

        <hr class="my-2" />
        <a class="@Cls("support")" asp-controller="Account" asp-action="CustomerService"><i class="bi bi-headset fs-5"></i> Müşteri Hizmetleri</a>
        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
            <button type="submit" class="@Cls("") dk-acc-logout w-100 text-start bg-transparent"><i class="bi bi-box-arrow-right fs-5"></i> Çıkış yap</button>
        </form>
    </nav>
</aside>
