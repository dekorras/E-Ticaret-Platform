@using Dekorras.Application.Content.Queries
@model IReadOnlyCollection<BlogPostListItemDto>
@{
    ViewData["Title"] = "Blog";
}

<h1 class="h3 mb-3">Blog</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">Henüz yayınlanmış bir yazı yok.</p>
}
else
{
    <div class="list-group">
        @foreach (var post in Model)
        {
            <a class="list-group-item list-group-item-action" asp-controller="Blog" asp-action="Details" asp-route-slug="@post.Slug">
                @post.Title
            </a>
        }
    </div>
}
