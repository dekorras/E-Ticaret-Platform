@using Dekorras.Application.Customers.Queries
@model IReadOnlyCollection<WishlistItemDto>
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Beğendiklerim";
    ViewData["AccountNav"] = "wishlist";
}

<h1 class="dk-acc-title h4 fw-bold mb-3">Beğendiklerim</h1>


@if (Model.Count == 0)
{
    <p class="text-muted">Beğendiğiniz ürün yok. Ürün sayfalarındaki kalp simgesiyle ürünleri bu listeye ekleyebilirsiniz.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Alışverişe Devam Et</a>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 g-3">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <a asp-controller="Product" asp-action="Details" asp-route-slug="@item.Slug">
                        @if (item.ImageUrl is not null)
                        {
                            <img src="@item.ImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@item.Name" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light text-muted" style="height: 200px;">Görsel Yok</div>
                        }
                    </a>
                    <div class="card-body">
                        <h5 class="card-title">
                            <a class="text-decoration-none" asp-controller="Product" asp-action="Details" asp-route-slug="@item.Slug">@item.Name</a>
                        </h5>
                        <p class="card-text fw-bold">@Html.Money(item.PriceTry)</p>
                        <p class="card-text">
                            @if (item.InStock)
                            {
                                <span class="badge bg-success">Stokta Var</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Stokta Yok</span>
                            }
                        </p>
                        <form asp-controller="Account" asp-action="RemoveFromWishlist" method="post">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Favorilerden Çıkar</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
