@model Dekorras.Storefront.Models.ProfileFormModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Kullanıcı bilgilerim";
    ViewData["AccountNav"] = "profile";
}

<h1 class="dk-acc-title h4 fw-bold mb-3">Kullanıcı bilgilerim</h1>

@if (TempData["ProfileMessage"] is string pm) { <div class="alert alert-success py-2">@pm</div> }

<section class="card card-body shadow-sm mb-3">
    <h2 class="h6 fw-bold mb-3">Üyelik bilgilerim</h2>
    <form asp-action="Profile" method="post" class="row g-3" style="max-width: 640px;">
        <div asp-validation-summary="ModelOnly" class="text-danger small col-12"></div>
        <div class="col-md-6">
            <label asp-for="FullName" class="form-label">Ad soyad</label>
            <input asp-for="FullName" class="form-control" autocomplete="name" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="PhoneNumber" class="form-label">Cep telefonu</label>
            <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" inputmode="tel" />
            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label">E-posta</label>
            <input asp-for="Email" class="form-control" readonly />
            <div class="form-text">E-posta adresiniz giriş bilginiz olduğu için buradan değiştirilemez.</div>
        </div>
        <div class="col-12"><button type="submit" class="btn btn-primary">Güncelle</button></div>
    </form>
</section>

<section class="card card-body shadow-sm mb-3">
    <h2 class="h6 fw-bold mb-3">Şifre değişikliği</h2>
    @if (TempData["PasswordMessage"] is string okMsg) { <div class="alert alert-success py-2">@okMsg</div> }
    @if (TempData["PasswordError"] is string errMsg) { <div class="alert alert-danger py-2">@errMsg</div> }
    <form asp-action="ChangePassword" method="post" class="row g-3" style="max-width: 640px;">
        <div class="col-md-6"><label class="form-label" for="currentPassword">Mevcut şifre</label><input type="password" id="currentPassword" name="currentPassword" class="form-control" autocomplete="current-password" required /></div>
        <div class="w-100"></div>
        <div class="col-md-6"><label class="form-label" for="newPassword">Yeni şifre</label><input type="password" id="newPassword" name="newPassword" class="form-control" autocomplete="new-password" required /></div>
        <div class="col-md-6"><label class="form-label" for="confirmPassword">Yeni şifre (tekrar)</label><input type="password" id="confirmPassword" name="confirmPassword" class="form-control" autocomplete="new-password" required /></div>
        <div class="col-12"><button type="submit" class="btn btn-outline-primary">Şifreyi değiştir</button></div>
    </form>
</section>

<section class="card card-body shadow-sm mb-3 flex-row flex-wrap align-items-center gap-3">
    <div class="flex-grow-1">
        <h2 class="h6 fw-bold mb-1">Adres bilgilerim</h2>
        <div class="small text-muted">Teslimat ve fatura adreslerinizi yönetin.</div>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Addresses">Adreslerim</a>
</section>

<section class="card card-body shadow-sm mb-3 flex-row flex-wrap align-items-center gap-3">
    <div class="flex-grow-1">
        <h2 class="h6 fw-bold mb-1">Bülten aboneliği</h2>
        <div class="small text-muted">Kampanya ve yeni ürünlerden e-postayla haberdar olun. Durum: <strong>@(Model.NewsletterSubscribed ? "Abone" : "Abone değil")</strong></div>
    </div>
    <form asp-action="SetNewsletterSubscription" method="post" class="m-0">
        <input type="hidden" name="subscribed" value="@(!Model.NewsletterSubscribed ? "true" : "false")" />
        <button type="submit" class="btn @(Model.NewsletterSubscribed ? "btn-outline-secondary" : "btn-primary")">@(Model.NewsletterSubscribed ? "Aboneliği bırak" : "Abone ol")</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
