@using Dekorras.Storefront.Models
@model AddressFormModel
@{
    ViewData["Title"] = "Yeni Adres";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="h3 mb-3">Yeni Adres</h1>

        <form asp-controller="Account" asp-action="AddAddress" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-2">
                <label class="form-label">Alıcı Adı</label>
                <input asp-for="RecipientName" class="form-control" />
            </div>
            <div class="row">
                <div class="col mb-2">
                    <label class="form-label">Ülke Kodu (ör. TR)</label>
                    <input asp-for="CountryCode" class="form-control" maxlength="2" />
                </div>
                <div class="col mb-2">
                    <label class="form-label">Eyalet/İl (opsiyonel)</label>
                    <input asp-for="State" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col mb-2">
                    <label class="form-label">Şehir</label>
                    <input asp-for="City" class="form-control" />
                </div>
                <div class="col mb-2">
                    <label class="form-label">İlçe (opsiyonel)</label>
                    <input asp-for="District" class="form-control" />
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label">Adres</label>
                <input asp-for="AddressLine1" class="form-control" />
            </div>
            <div class="mb-2">
                <label class="form-label">Adres (devamı, opsiyonel)</label>
                <input asp-for="AddressLine2" class="form-control" />
            </div>
            <div class="row">
                <div class="col mb-2">
                    <label class="form-label">Posta Kodu (opsiyonel)</label>
                    <input asp-for="PostalCode" class="form-control" />
                </div>
                <div class="col mb-3">
                    <label class="form-label">Telefon</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Addresses">İptal</a>
        </form>
    </div>
</div>
