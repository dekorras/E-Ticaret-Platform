@using Dekorras.Application.Ordering.Storefront
@model CartDto
@{
    ViewData["Title"] = Localizer["Sepetim"];
    var couponMessage = TempData["CouponMessage"] as string;
    var couponSuccess = TempData["CouponSuccess"] as bool?;
    var giftVoucherMessage = TempData["GiftVoucherMessage"] as string;
    var giftVoucherSuccess = TempData["GiftVoucherSuccess"] as bool?;
}

<h1 class="h3 mb-3">@Localizer["Sepetim"]</h1>

@if (Model.Items.Count == 0)
{
    <p class="text-muted">@Localizer["Sepetiniz boş."]</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">@Localizer["Alışverişe Devam Et"]</a>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>@Localizer["Ürün"]</th>
                <th>@Localizer["Birim Fiyat (KDV hariç)"]</th>
                <th>@Localizer["Adet"]</th>
                <th>@Localizer["Tutar (KDV hariç)"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                @if (item.RequiresConfiguration)
                {
                    @* Konfigüratörden önce ölçüsüz eklenmiş (eski sabit fiyatlı) duvar kağıdı/poster: toplama katılmaz,
                       siparişe dönüştürülemez; müşteri ölçüsünü seçip yeniden ekler ya da kaldırır. *@
                    <tr class="table-warning" data-wall-legacy-line>
                        <td colspan="4">
                            <a asp-controller="Product" asp-action="Details" asp-route-slug="@item.Slug">@item.Name</a>
                            <div class="small mt-1">
                                <i class="bi bi-exclamation-triangle"></i>
                                @Localizer["Bu ürün artık duvarınızın ölçüsüne göre üretiliyor ve fiyatı ölçüye göre hesaplanıyor. Ölçü seçilmeden eklendiği için toplama katılmadı; lütfen ölçünüzü seçip yeniden ekleyin."]
                            </div>
                            <a class="btn btn-sm btn-primary mt-2" asp-controller="Product" asp-action="Details" asp-route-slug="@item.Slug">@Localizer["Ölçünü Seç"]</a>
                        </td>
                        <td>
                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="variantId" value="@item.VariantId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Kaldır"]</button>
                            </form>
                        </td>
                    </tr>
                    continue;
                }
                <tr>
                    <td>
                        <a asp-controller="Product" asp-action="Details" asp-route-slug="@item.Slug">@item.Name</a>
                        @if (item.VariantOptionName is not null)
                        {
                            <div class="text-muted small">@item.VariantOptionName</div>
                        }
                        @if (item.Configuration is { } cfg)
                        {
                            <div class="text-muted small" data-wall-config>
                                @cfg.WidthCm.ToString("0.#") × @cfg.HeightCm.ToString("0.#") cm · @cfg.MaterialName
                                · @(cfg.Fit == "Stretch" ? "Esnet" : "Kırp")@(cfg.Mirror ? " · Ayna" : "")@(cfg.Filter == "Grayscale" ? " · Siyah-Beyaz" : cfg.Filter == "Sepia" ? " · Sepya" : "")
                                <br />@cfg.BilledAreaM2.ToString("0.##") m² faturalanan (kesim payı dahil) · @cfg.PanelCount panel
                                <br /><wall-preview-link product="@item.Slug" config="@(Dekorras.Domain.WallCovering.WallConfiguration.FromJson(cfg.ConfigurationJson))" variant="text" source="sepet" />
                            </div>
                        }
                    </td>
                    <td>@Html.Money(item.UnitPriceTry)</td>
                    <td style="max-width: 120px;">
                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex gap-1">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="hidden" name="variantId" value="@item.VariantId" />
                            @if (item.Configuration is not null)
                            {
                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                            }
                            <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@Localizer["Güncelle"]</button>
                        </form>
                    </td>
                    <td>@Html.Money(item.LineTotalTry)</td>
                    <td>
                        <form asp-controller="Cart" asp-action="Remove" method="post">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="hidden" name="variantId" value="@item.VariantId" />
                            @if (item.Configuration is not null)
                            {
                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                            }
                            <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Kaldır"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end">@Localizer["Ara Toplam (KDV hariç)"]</td>
                <td>@Html.Money(Model.SubTotalTry)</td>
                <td></td>
            </tr>
            @if (Model.GlueDiscountTry > 0)
            {
                <tr>
                    <td colspan="3" class="text-end">Ücretsiz tutkal</td>
                    <td class="text-success">-@Html.Money(Model.GlueDiscountTry)</td>
                    <td></td>
                </tr>
            }
            @if (Model.CouponCode is not null)
            {
                <tr>
                    <td colspan="3" class="text-end">@Localizer["Kupon ({0}) İndirimi", Model.CouponCode]</td>
                    <td class="text-success">-@Html.Money(Model.DiscountTry)</td>
                    <td>
                        <form asp-controller="Cart" asp-action="RemoveCoupon" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Kaldır"]</button>
                        </form>
                    </td>
                </tr>
            }
            else if (Model.CampaignName is not null)
            {
                <tr>
                    <td colspan="3" class="text-end">
                        @Localizer["Kampanya İndirimi ({0})", Model.CampaignName]
                    </td>
                    <td class="text-success">-@Html.Money(Model.DiscountTry)</td>
                    <td></td>
                </tr>
            }
            <tr data-cart-tax>
                <td colspan="3" class="text-end">@Localizer["KDV"]</td>
                <td>@Html.Money(Model.TaxTotalTry)</td>
                <td></td>
            </tr>
            @if (Model.GiftVoucherCode is not null)
            {
                <tr>
                    <td colspan="3" class="text-end">@Localizer["Hediye Çeki ({0})", Model.GiftVoucherCode]</td>
                    <td class="text-success">-@Html.Money(Model.GiftVoucherAmountAppliedTry)</td>
                    <td>
                        <form asp-controller="Cart" asp-action="RemoveGiftVoucher" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Kaldır"]</button>
                        </form>
                    </td>
                </tr>
            }
            <tr>
                <td colspan="3" class="text-end fw-bold">@Localizer["Toplam (KDV dahil)"]</td>
                <td class="fw-bold" data-cart-grand-total>@Html.Money(Model.GrandTotalTry)</td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    @if (Model.FreeShipping)
    {
        <div class="alert alert-success py-2">Kargo ücretsiz.</div>
    }
    else if (Model.FreeShippingRemainingTry is decimal remaining && remaining > 0)
    {
        <div class="alert alert-info py-2">Ücretsiz kargo için <strong>@Html.Money(remaining)</strong> daha ekleyin.</div>
    }

    @foreach (var glue in Model.GlueSuggestions ?? [])
    {
        <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2 py-2" data-glue-suggestion>
            <span>Seçtiğiniz malzeme uygulama için tutkal gerektirir: <strong>@glue.Name</strong>
                @if (glue.WillBeFree)
                {
                    <span class="badge bg-success">Sepetinizde ücretsiz</span>
                }
                else
                {
                    <span>(@Html.Money(glue.UnitPriceTry))</span>
                }
            </span>
            <form asp-controller="Cart" asp-action="Add" method="post" class="ms-auto">
                <input type="hidden" name="productId" value="@glue.GlueProductId" />
                <input type="hidden" name="quantity" value="@glue.SuggestedQuantity" />
                <button type="submit" class="btn btn-sm btn-warning">Tutkal ekle (@glue.SuggestedQuantity adet)</button>
            </form>
        </div>
    }

    <div class="row mb-3">
        <div class="col-md-4">
            <form asp-controller="Cart" asp-action="ApplyCoupon" method="post" class="d-flex gap-1">
                <input type="text" name="couponCode" class="form-control" placeholder="@Localizer["Kupon Kodu"]" />
                <button type="submit" class="btn btn-outline-primary">@Localizer["Uygula"]</button>
            </form>
            @if (couponMessage is not null)
            {
                <p class="mt-2 @(couponSuccess == true ? "text-success" : "text-danger")">@couponMessage</p>
            }
        </div>
        <div class="col-md-4">
            <form asp-controller="Cart" asp-action="ApplyGiftVoucher" method="post" class="d-flex gap-1">
                <input type="text" name="giftVoucherCode" class="form-control" placeholder="@Localizer["Hediye Çeki Kodu"]" />
                <button type="submit" class="btn btn-outline-primary">@Localizer["Uygula"]</button>
            </form>
            @if (giftVoucherMessage is not null)
            {
                <p class="mt-2 @(giftVoucherSuccess == true ? "text-success" : "text-danger")">@giftVoucherMessage</p>
            }
        </div>
    </div>

    <a class="btn btn-success" asp-controller="Checkout" asp-action="Index">@Localizer["Ödemeye Geç"]</a>
}
