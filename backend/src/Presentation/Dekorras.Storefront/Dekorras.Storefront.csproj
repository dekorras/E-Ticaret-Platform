<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Dekorras.Application\Dekorras.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Dekorras.Persistence\Dekorras.Persistence.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Dekorras.Infrastructure\Dekorras.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" Version="4.8.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Yüklenen dosyalar (wwwroot/uploads, ~1 GB) ve özel dosyalar (App_Data) çalışma zamanı verisidir: derlemenin statik
         varlık listesine ve yayın (publish) çıktısına GİRMEZ; UseStaticFiles "/uploads" altında doğrudan klasörden sunar. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\uploads\**;App_Data\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
